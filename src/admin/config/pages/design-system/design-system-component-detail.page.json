    "inlineScripts": [
      {
        "code": "(function(){try{var s=new URLSearchParams(window.location.search).get('scheme');var root=document.documentElement;if(s==='dark'){root.classList.add('dark')}else if(s==='light'){root.classList.remove('dark')}}catch(e){}})();",
        "position": "head"
      }
    ]
