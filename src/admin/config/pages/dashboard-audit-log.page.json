{
  "id": "dashboard-audit-log",
  "name": "dashboard-audit-log",
  "path": "/audit-log",
  "meta": {
    "title": "$t:admin.meta.auditLog"
  },
  "components": [
    {
      "component": "console-shell",
      "key": "container-1",
      "vars": {
        "bodyClass": "flex min-w-0 flex-1 flex-col gap-6 px-4 py-4 lg:px-6 md:py-6 min-h-0"
      },
      "slots": {
        "trail": [
          {
            "type": "breadcrumb",
            "separator": "›",
            "props": {
              "className": "min-w-0 flex-initial overflow-hidden [&_ol]:min-w-0 [&_ol]:flex-nowrap [&_li]:shrink-0 [&_li:first-child]:min-w-0 [&_li:first-child]:shrink [&_li:first-child>*]:block [&_li:first-child>*]:truncate [&_li:last-child]:min-w-0 [&_li:last-child]:shrink [&_li:last-child>*]:block [&_li:last-child>*]:truncate max-sm:[&_li:not(:first-child):not(:nth-last-child(-n+2))]:hidden",
              "data-testid": "breadcrumb"
            },
            "derive": "path",
            "home": {
              "label": "$app.label"
            },
            "labels": {
              "audit-log": "$t:admin.crumb.auditLog"
            }
          },
          {
            "component": "console-header-end",
            "key": "chrome-end"
          }
        ]
      },
      "children": [
        {
          "type": "container",
          "key": "header",
          "element": "header",
          "props": {
            "className": "flex flex-col gap-1"
          },
          "children": [
            {
              "type": "text",
              "element": "h1",
              "props": {
                "className": "text-foreground text-2xl font-semibold tracking-tight"
              },
              "content": "$t:admin.auditLog.heading"
            },
            {
              "type": "text",
              "element": "p",
              "props": {
                "className": "text-muted-foreground max-w-3xl text-sm"
              },
              "content": "$t:admin.auditLog.blurb"
            }
          ]
        },
        {
          "type": "container",
          "key": "admin-toolbar-row",
          "element": "div",
          "props": {
            "className": "flex min-h-10 flex-wrap items-center gap-2",
            "data-testid": "admin-toolbar-row",
            "role": "toolbar",
            "aria-label": "$t:admin.common.gridControls"
          },
          "children": [
            {
              "component": "console-toolbar-search",
              "key": "toolbar-search",
              "vars": {
                "ariaLabel": "$t:admin.auditLog.search",
                "placeholder": "$t:admin.auditLog.search",
                "publishes": {
                  "bindTo": "audit-log-filter",
                  "param": "q"
                }
              }
            },
            {
              "type": "native-select",
              "props": {
                "id": "audit-log-actor-filter",
                "label": "$t:admin.auditLog.filter.actor",
                "className": "flex w-fit items-center [&>[data-slot=label]]:sr-only [&_[data-slot=native-select]]:border-dashed [&_[data-slot=native-select]]:font-medium"
              },
              "emptyOption": {
                "label": "$t:admin.auditLog.filter.allActors"
              },
              "publishes": {
                "bindTo": "audit-log-filter",
                "param": "actorId"
              },
              "dataSource": {
                "system": {
                  "endpoint": "/api/admin/audit-log/facets",
                  "rowsKey": "actors",
                  "idKey": "id"
                },
                "valueKey": "id",
                "labelKey": "label"
              }
            },
            {
              "type": "native-select",
              "props": {
                "id": "audit-log-action-filter",
                "label": "$t:admin.auditLog.filter.action",
                "className": "flex w-fit items-center [&>[data-slot=label]]:sr-only [&_[data-slot=native-select]]:border-dashed [&_[data-slot=native-select]]:font-medium"
              },
              "emptyOption": {
                "label": "$t:admin.auditLog.filter.allActions"
              },
              "publishes": {
                "bindTo": "audit-log-filter",
                "param": "action"
              },
              "dataSource": {
                "system": {
                  "endpoint": "/api/admin/audit-log/facets",
                  "rowsKey": "actions",
                  "idKey": "action"
                },
                "valueKey": "action",
                "labelKey": "action"
              }
            },
            {
              "type": "native-select",
              "props": {
                "id": "audit-log-transport-filter",
                "label": "$t:admin.auditLog.filter.transport",
                "className": "flex w-fit items-center [&>[data-slot=label]]:sr-only [&_[data-slot=native-select]]:border-dashed [&_[data-slot=native-select]]:font-medium"
              },
              "emptyOption": {
                "label": "$t:admin.auditLog.filter.allTransports"
              },
              "publishes": {
                "bindTo": "audit-log-filter",
                "param": "transport"
              },
              "options": [
                {
                  "value": "config-file",
                  "label": "$t:admin.auditLog.transport.configfile"
                },
                {
                  "value": "env",
                  "label": "$t:admin.auditLog.transport.env"
                },
                {
                  "value": "api",
                  "label": "$t:admin.auditLog.transport.api"
                },
                {
                  "value": "mcp",
                  "label": "$t:admin.auditLog.transport.mcp"
                },
                {
                  "value": "restore",
                  "label": "$t:admin.auditLog.transport.restore"
                }
              ]
            },
            {
              "type": "native-select",
              "props": {
                "id": "audit-log-resource-filter",
                "label": "$t:admin.auditLog.filter.resource",
                "className": "flex w-fit items-center [&>[data-slot=label]]:sr-only [&_[data-slot=native-select]]:border-dashed [&_[data-slot=native-select]]:font-medium"
              },
              "emptyOption": {
                "label": "$t:admin.auditLog.filter.allResources"
              },
              "publishes": {
                "bindTo": "audit-log-filter",
                "param": "resourceType"
              },
              "options": [
                {
                  "value": "user",
                  "label": "$t:admin.auditLog.resource.user"
                },
                {
                  "value": "config",
                  "label": "$t:admin.auditLog.resource.config"
                },
                {
                  "value": "table",
                  "label": "$t:admin.auditLog.resource.table"
                },
                {
                  "value": "table.record",
                  "label": "$t:admin.auditLog.resource.record"
                },
                {
                  "value": "form",
                  "label": "$t:admin.auditLog.resource.form"
                },
                {
                  "value": "form.submission",
                  "label": "$t:admin.auditLog.resource.submission"
                },
                {
                  "value": "automation",
                  "label": "$t:admin.auditLog.resource.automation"
                },
                {
                  "value": "automation.run",
                  "label": "$t:admin.auditLog.resource.automationRun"
                },
                {
                  "value": "agent",
                  "label": "$t:admin.auditLog.resource.agent"
                },
                {
                  "value": "bucket",
                  "label": "$t:admin.auditLog.resource.bucket"
                },
                {
                  "value": "link",
                  "label": "$t:admin.auditLog.resource.link"
                },
                {
                  "value": "connection",
                  "label": "$t:admin.auditLog.resource.connection"
                },
                {
                  "value": "group",
                  "label": "$t:admin.auditLog.resource.group"
                },
                {
                  "value": "design.share",
                  "label": "$t:admin.auditLog.resource.designShare"
                }
              ]
            },
            {
              "type": "date-range-picker",
              "props": {
                "id": "audit-log-period-filter",
                "className": "[&>div>span:first-child]:sr-only [&_button]:h-8! [&_button]:py-0! [&_button]:text-sm!"
              },
              "label": "$t:admin.auditLog.filter.period",
              "placeholder": "$t:admin.auditLog.filter.anyTime",
              "presets": ["today", "yesterday", "last-7-days", "this-month", "last-month"],
              "publishes": {
                "bindTo": "audit-log-filter",
                "params": {
                  "from": "from",
                  "to": "to"
                }
              }
            },
            {
              "type": "container",
              "key": "reads-toggle-row",
              "element": "div",
              "props": {
                "className": "flex items-center gap-2"
              },
              "children": [
                {
                  "type": "switch",
                  "props": {
                    "id": "audit-log-reads-toggle",
                    "aria-label": "$t:admin.auditLog.filter.showReads"
                  },
                  "publishes": {
                    "bindTo": "audit-log-filter",
                    "param": "reads"
                  }
                },
                {
                  "type": "label",
                  "for": "audit-log-reads-toggle",
                  "text": "$t:admin.auditLog.filter.showReads"
                }
              ]
            }
          ]
        },
        {
          "component": "console-grid",
          "key": "grid",
          "vars": {
            "id": "admin-audit-log-grid",
            "ariaLabel": "$t:admin.auditLog.region",
            "dataSource": {
              "system": {
                "endpoint": "/api/admin/audit-log",
                "rowsKey": "items",
                "idKey": "id",
                "query": {
                  "limit": "200",
                  "reads": "false"
                },
                "bindTo": "audit-log-filter",
                "sharedFilter": {
                  "params": [
                    "q",
                    "actorId",
                    "action",
                    "transport",
                    "resourceType",
                    "from",
                    "to",
                    "reads"
                  ]
                }
              }
            },
            "columns": [
              {
                "field": "timestamp",
                "label": "$t:admin.auditLog.col.time",
                "format": "day-relative-time",
                "width": 160
              },
              {
                "field": "actor.email",
                "label": "$t:admin.auditLog.col.actor",
                "width": 240,
                "truncate": true
              },
              {
                "field": "action",
                "label": "$t:admin.auditLog.col.action",
                "minWidth": 220,
                "secondaryField": "action",
                "valueLabels": {
                  "account.deletion.scheduled": "$t:admin.auditLog.action.account.deletion.scheduled",
                  "account.deletion.requested": "$t:admin.auditLog.action.account.deletion.requested",
                  "account.deletion.deferred": "$t:admin.auditLog.action.account.deletion.deferred",
                  "account.deletion.purged": "$t:admin.auditLog.action.account.deletion.purged",
                  "config.version.queried": "$t:admin.auditLog.action.config.version.queried",
                  "config.schema.queried": "$t:admin.auditLog.action.config.schema.queried",
                  "config.env.queried": "$t:admin.auditLog.action.config.env.queried",
                  "config.design.queried": "$t:admin.auditLog.action.config.design.queried",
                  "table.overview.queried": "$t:admin.auditLog.action.table.overview.queried",
                  "table.record.created": "$t:admin.auditLog.action.table.record.created",
                  "table.record.updated": "$t:admin.auditLog.action.table.record.updated",
                  "table.record.deleted": "$t:admin.auditLog.action.table.record.deleted",
                  "table.record.button.invoked": "$t:admin.auditLog.action.table.record.button.invoked",
                  "bucket.list.queried": "$t:admin.auditLog.action.bucket.list.queried",
                  "bucket.overview.queried": "$t:admin.auditLog.action.bucket.overview.queried",
                  "bucket.files.queried": "$t:admin.auditLog.action.bucket.files.queried",
                  "bucket.file.uploaded": "$t:admin.auditLog.action.bucket.file.uploaded",
                  "form.list.queried": "$t:admin.auditLog.action.form.list.queried",
                  "form.detail.queried": "$t:admin.auditLog.action.form.detail.queried",
                  "form.submission.list.queried": "$t:admin.auditLog.action.form.submission.list.queried",
                  "form.submission.detail.queried": "$t:admin.auditLog.action.form.submission.detail.queried",
                  "form.submission.bulk.queried": "$t:admin.auditLog.action.form.submission.bulk.queried",
                  "form.submission.body.revealed": "$t:admin.auditLog.action.form.submission.body.revealed",
                  "form.submission.bodies.revealed": "$t:admin.auditLog.action.form.submission.bodies.revealed",
                  "form.analytics.queried": "$t:admin.auditLog.action.form.analytics.queried",
                  "form.export.queried": "$t:admin.auditLog.action.form.export.queried",
                  "user.overview.queried": "$t:admin.auditLog.action.user.overview.queried",
                  "user.role.changed": "$t:admin.auditLog.action.user.role.changed",
                  "user.impersonation.started": "$t:admin.auditLog.action.user.impersonation.started",
                  "user.impersonation.stopped": "$t:admin.auditLog.action.user.impersonation.stopped",
                  "user.banned": "$t:admin.auditLog.action.user.banned",
                  "user.unbanned": "$t:admin.auditLog.action.user.unbanned",
                  "user.password.set": "$t:admin.auditLog.action.user.password.set",
                  "user.groups.changed": "$t:admin.auditLog.action.user.groups.changed",
                  "scim.user.created": "$t:admin.auditLog.action.scim.user.created",
                  "scim.user.updated": "$t:admin.auditLog.action.scim.user.updated",
                  "scim.user.deactivated": "$t:admin.auditLog.action.scim.user.deactivated",
                  "scim.user.reactivated": "$t:admin.auditLog.action.scim.user.reactivated",
                  "scim.group.members.updated": "$t:admin.auditLog.action.scim.group.members.updated",
                  "automation.overview.queried": "$t:admin.auditLog.action.automation.overview.queried",
                  "automation.runs.list.queried": "$t:admin.auditLog.action.automation.runs.list.queried",
                  "automation.runs.detail.queried": "$t:admin.auditLog.action.automation.runs.detail.queried",
                  "automation.paused": "$t:admin.auditLog.action.automation.paused",
                  "automation.resumed": "$t:admin.auditLog.action.automation.resumed",
                  "automation.auto_paused": "$t:admin.auditLog.action.automation.auto_paused",
                  "agent.conversation.list.queried": "$t:admin.auditLog.action.agent.conversation.list.queried",
                  "agent.conversation.detail.queried": "$t:admin.auditLog.action.agent.conversation.detail.queried",
                  "agent.list.queried": "$t:admin.auditLog.action.agent.list.queried",
                  "agent.detail.queried": "$t:admin.auditLog.action.agent.detail.queried",
                  "connection.list.queried": "$t:admin.auditLog.action.connection.list.queried",
                  "connection.detail.queried": "$t:admin.auditLog.action.connection.detail.queried",
                  "link.created": "$t:admin.auditLog.action.link.created",
                  "link.updated": "$t:admin.auditLog.action.link.updated",
                  "link.deleted": "$t:admin.auditLog.action.link.deleted",
                  "link.disabled": "$t:admin.auditLog.action.link.disabled",
                  "link.enabled": "$t:admin.auditLog.action.link.enabled",
                  "design.share.created": "$t:admin.auditLog.action.design.share.created",
                  "design.share.revoked": "$t:admin.auditLog.action.design.share.revoked"
                }
              },
              {
                "field": "resource.type",
                "label": "$t:admin.auditLog.col.resource",
                "width": 180,
                "valueLabels": {
                  "user": "$t:admin.auditLog.resource.user",
                  "config": "$t:admin.auditLog.resource.config",
                  "table": "$t:admin.auditLog.resource.table",
                  "table.record": "$t:admin.auditLog.resource.record",
                  "form": "$t:admin.auditLog.resource.form",
                  "form.submission": "$t:admin.auditLog.resource.submission",
                  "automation": "$t:admin.auditLog.resource.automation",
                  "automation.run": "$t:admin.auditLog.resource.automationRun",
                  "agent": "$t:admin.auditLog.resource.agent",
                  "bucket": "$t:admin.auditLog.resource.bucket",
                  "link": "$t:admin.auditLog.resource.link",
                  "connection": "$t:admin.auditLog.resource.connection",
                  "group": "$t:admin.auditLog.resource.group",
                  "design.share": "$t:admin.auditLog.resource.designShare"
                }
              },
              {
                "field": "resource.id",
                "label": "$t:admin.auditLog.col.resourceId",
                "minWidth": 140,
                "format": "short-id",
                "copyLabel": "$t:admin.auditLog.copyResourceId"
              },
              {
                "field": "result",
                "label": "$t:admin.auditLog.col.result",
                "width": 120,
                "valueLabels": {
                  "success": "$t:admin.auditLog.result.success",
                  "failure": "$t:admin.auditLog.result.failure"
                },
                "cellStyle": [
                  {
                    "when": {
                      "eq": "success"
                    },
                    "className": "[&:is(span)]:inline-flex [&:is(span)]:items-center [&:is(span)]:gap-1.5 [&:is(span)]:rounded-md [&:is(span)]:border [&:is(span)]:border-border [&:is(span)]:px-1.5 [&:is(span)]:py-0.5 [&:is(span)]:text-xs [&:is(span)]:font-medium [&:is(span)]:before:size-1.5 [&:is(span)]:before:shrink-0 [&:is(span)]:before:rounded-full [&:is(span)]:before:content-[''] [&:is(span)]:text-muted-foreground [&:is(span)]:before:bg-success-solid"
                  },
                  {
                    "when": {
                      "eq": "failure"
                    },
                    "className": "[&:is(span)]:inline-flex [&:is(span)]:items-center [&:is(span)]:gap-1.5 [&:is(span)]:rounded-md [&:is(span)]:border [&:is(span)]:border-border [&:is(span)]:px-1.5 [&:is(span)]:py-0.5 [&:is(span)]:text-xs [&:is(span)]:font-medium [&:is(span)]:before:size-1.5 [&:is(span)]:before:shrink-0 [&:is(span)]:before:rounded-full [&:is(span)]:before:content-[''] [&:is(span)]:text-destructive [&:is(span)]:before:bg-destructive"
                  }
                ]
              },
              {
                "field": "transport",
                "label": "$t:admin.auditLog.col.transport",
                "width": 140,
                "valueLabels": {
                  "config-file": "$t:admin.auditLog.transport.configfile",
                  "env": "$t:admin.auditLog.transport.env",
                  "api": "$t:admin.auditLog.transport.api",
                  "mcp": "$t:admin.auditLog.transport.mcp",
                  "restore": "$t:admin.auditLog.transport.restore"
                }
              }
            ],
            "emptyMessage": "$t:admin.auditLog.empty",
            "noMatchMessage": "$t:admin.auditLog.noMatch",
            "layout": "fill",
            "onRowClick": {
              "action": "openSheet",
              "component": "admin-audit-log-entry"
            },
            "viewOptions": "toolbar",
            "selection": {
              "mode": "multiple"
            },
            "countLabel": {
              "one": "$t:admin.auditLog.count.one",
              "other": "$t:admin.auditLog.count.other"
            }
          }
        },
        {
          "component": "console-record-sheet",
          "key": "record-sheet",
          "vars": {
            "id": "admin-audit-log-entry",
            "dataSource": {
              "system": {
                "endpoint": "/api/admin/audit-log/:id",
                "param": "id"
              }
            },
            "canEdit": false,
            "props": {
              "title": "$t:admin.auditLog.entry.title"
            },
            "recordFields": [
              {
                "name": "action",
                "type": "single-line-text",
                "label": "$t:admin.auditLog.col.action"
              },
              {
                "name": "timestamp",
                "type": "datetime",
                "label": "$t:admin.auditLog.col.time"
              },
              {
                "name": "result",
                "type": "single-line-text",
                "label": "$t:admin.auditLog.col.result"
              },
              {
                "name": "transport",
                "type": "single-line-text",
                "label": "$t:admin.auditLog.col.transport"
              },
              {
                "name": "actor",
                "type": "json",
                "label": "$t:admin.auditLog.col.actor",
                "renderAs": "key-value"
              },
              {
                "name": "resource",
                "type": "json",
                "label": "$t:admin.auditLog.col.resource",
                "renderAs": "key-value"
              },
              {
                "name": "metadata",
                "type": "json",
                "label": "$t:admin.auditLog.entry.details",
                "renderAs": "key-value"
              }
            ]
          }
        }
      ]
    }
  ]
}
