{
  "id": "dashboard-mcp-docs",
  "name": "dashboard-mcp-docs",
  "path": "/mcp",
  "meta": {
    "title": "$t:admin.meta.mcp"
  },
  "dataSource": {
    "system": {
      "endpoint": "/api/admin/instance"
    }
  },
  "components": [
    {
      "component": "console-shell",
      "key": "container-1",
      "vars": {
        "bodyClass": "flex min-w-0 flex-1 flex-col gap-6 px-4 py-4 lg:px-6 md:py-6"
      },
      "slots": {
        "trail": [
          {
            "type": "breadcrumb",
            "separator": "›",
            "props": {
              "className": "min-w-0 flex-initial overflow-hidden [&_ol]:min-w-0 [&_ol]:flex-nowrap [&_li]:shrink-0 [&_li:first-child]:min-w-0 [&_li:first-child]:shrink [&_li:first-child>*]:block [&_li:first-child>*]:truncate [&_li:last-child]:min-w-0 [&_li:last-child]:shrink [&_li:last-child>*]:block [&_li:last-child>*]:truncate max-sm:[&_li:not(:first-child):not(:nth-last-child(-n+2))]:hidden",
              "data-testid": "breadcrumb"
            },
            "derive": "path",
            "home": {
              "label": "$app.label"
            },
            "labels": {
              "mcp": "$t:admin.crumb.mcp"
            }
          },
          {
            "component": "console-header-end",
            "key": "chrome-end"
          }
        ]
      },
      "children": [
        {
          "type": "container",
          "key": "header",
          "element": "header",
          "props": {
            "className": "flex flex-col gap-1"
          },
          "children": [
            {
              "type": "text",
              "element": "h1",
              "props": {
                "className": "text-foreground text-2xl font-semibold tracking-tight"
              },
              "content": "$t:admin.mcp.heading"
            },
            {
              "type": "text",
              "element": "p",
              "props": {
                "className": "text-muted-foreground max-w-3xl text-sm"
              },
              "content": "$t:admin.mcp.blurb"
            }
          ]
        },
        {
          "type": "container",
          "key": "admin-surface-content-2-2",
          "element": "div",
          "props": {
            "className": "flex flex-col gap-8"
          },
          "children": [
            {
              "component": "console-facts-card",
              "key": "facts-card",
              "children": [
                {
                  "type": "container",
                  "key": "admin-surface-content-2-2-1",
                  "props": {
                    "className": "border-b border-border p-6"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-xl font-semibold text-foreground"
                      },
                      "content": "$t:admin.mcp.endpoint.heading"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "mt-1 text-sm text-muted-foreground"
                      },
                      "content": "$t:admin.mcp.endpoint.blurb"
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "admin-surface-content-2-2-2",
                  "element": "div",
                  "props": {
                    "className": "flex flex-col gap-3 px-6 pb-6"
                  },
                  "children": [
                    {
                      "type": "code",
                      "filename": "$t:admin.mcp.endpoint.filename",
                      "props": {
                        "language": "http",
                        "data-testid": "mcp-connect-endpoint"
                      },
                      "content": "$record.origin/mcp"
                    }
                  ]
                }
              ]
            },
            {
              "component": "console-facts-card",
              "key": "facts-card-2",
              "children": [
                {
                  "type": "container",
                  "key": "admin-surface-content-2-2-1-2",
                  "props": {
                    "className": "border-b border-border p-6"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-xl font-semibold text-foreground"
                      },
                      "content": "$t:admin.mcp.credential.heading"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "mt-1 text-sm text-muted-foreground"
                      },
                      "content": "$t:admin.mcp.credential.blurb"
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "admin-surface-content-2-2-2-2",
                  "element": "div",
                  "props": {
                    "className": "flex flex-col gap-3 px-6 pb-6"
                  },
                  "children": [
                    {
                      "type": "code",
                      "props": {
                        "language": "bash",
                        "data-testid": "mcp-connect-register"
                      },
                      "content": "$t:admin.mcp.credential.comment\ncurl -X POST '$record.origin/api/auth/oauth2/register' \\\n  --header 'Content-Type: application/json' \\\n  --cookie \"$SOVRIUM_SESSION\" \\\n  --data '{\n    \"client_name\": \"$app.name\",\n    \"redirect_uris\": [\"$record.origin/oauth/callback\"],\n    \"application_type\": \"$record.oauthApplicationType\",\n    \"grant_types\": [\"authorization_code\", \"refresh_token\"],\n    \"token_endpoint_auth_method\": \"client_secret_post\"\n  }'"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-foreground-subtle text-sm"
                      },
                      "content": "$t:admin.mcp.credential.anonymous"
                    }
                  ]
                }
              ]
            },
            {
              "component": "console-facts-card",
              "key": "facts-card-3",
              "children": [
                {
                  "type": "container",
                  "key": "admin-surface-content-2-2-1-3",
                  "props": {
                    "className": "border-b border-border p-6"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-xl font-semibold text-foreground"
                      },
                      "content": "$t:admin.mcp.config.heading"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "mt-1 text-sm text-muted-foreground"
                      },
                      "content": "$t:admin.mcp.config.blurb"
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "admin-surface-content-2-2-2-3",
                  "element": "div",
                  "props": {
                    "className": "flex flex-col gap-3 px-6 pb-6"
                  },
                  "children": [
                    {
                      "type": "code",
                      "filename": "$t:admin.mcp.config.filename",
                      "props": {
                        "language": "json",
                        "data-testid": "mcp-reference-config"
                      },
                      "content": "{\n  \"mcpServers\": {\n    \"$app.name\": {\n      \"url\": \"$record.origin/mcp\",\n      \"transport\": \"http\"\n    }\n  }\n}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "key": "mcp-tools-section",
              "element": "section",
              "props": {
                "aria-label": "$t:admin.mcp.tools.region",
                "data-testid": "mcp-tools-section",
                "className": "flex flex-col gap-4"
              },
              "children": [
                {
                  "type": "text",
                  "element": "h2",
                  "props": {
                    "className": "text-foreground-subtle text-sm font-medium tracking-wide uppercase"
                  },
                  "content": "$t:admin.mcp.tools.heading"
                },
                {
                  "type": "container",
                  "key": "mcp-tools-section-2",
                  "element": "div",
                  "props": {
                    "className": "flex flex-col gap-2"
                  },
                  "visibility": {
                    "record": {
                      "field": "mcpToolCountTable",
                      "gt": 0
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h3",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.mcp.tools.data"
                    },
                    {
                      "type": "list",
                      "props": {
                        "className": "bg-card text-card-foreground overflow-hidden rounded-xl ring-1 ring-foreground/10 divide-border divide-y"
                      },
                      "dataSource": {
                        "system": {
                          "endpoint": "/api/admin/mcp/tools",
                          "rowsKey": "tools",
                          "idKey": "name",
                          "query": {
                            "category": "table"
                          }
                        }
                      },
                      "children": [
                        {
                          "type": "container",
                          "key": "mcp-tools-section-2-1",
                          "element": "div",
                          "props": {
                            "className": "flex flex-col gap-0.5 px-3 py-2"
                          },
                          "children": [
                            {
                              "type": "text",
                              "element": "code",
                              "props": {
                                "className": "text-foreground font-mono text-sm"
                              },
                              "content": "$record.name"
                            },
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground-subtle text-sm"
                              },
                              "content": "$record.description"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "mcp-tools-section-3",
                  "element": "div",
                  "props": {
                    "className": "flex flex-col gap-2"
                  },
                  "visibility": {
                    "record": {
                      "field": "mcpToolCountAction",
                      "gt": 0
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h3",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.mcp.tools.actions"
                    },
                    {
                      "type": "list",
                      "props": {
                        "className": "bg-card text-card-foreground overflow-hidden rounded-xl ring-1 ring-foreground/10 divide-border divide-y"
                      },
                      "dataSource": {
                        "system": {
                          "endpoint": "/api/admin/mcp/tools",
                          "rowsKey": "tools",
                          "idKey": "name",
                          "query": {
                            "category": "action"
                          }
                        }
                      },
                      "children": [
                        {
                          "type": "container",
                          "key": "mcp-tools-section-3-1",
                          "element": "div",
                          "props": {
                            "className": "flex flex-col gap-0.5 px-3 py-2"
                          },
                          "children": [
                            {
                              "type": "text",
                              "element": "code",
                              "props": {
                                "className": "text-foreground font-mono text-sm"
                              },
                              "content": "$record.name"
                            },
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground-subtle text-sm"
                              },
                              "content": "$record.description"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "mcp-tools-section-4",
                  "element": "div",
                  "props": {
                    "className": "flex flex-col gap-2"
                  },
                  "visibility": {
                    "record": {
                      "field": "mcpToolCountAutomation",
                      "gt": 0
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h3",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.mcp.tools.automations"
                    },
                    {
                      "type": "list",
                      "props": {
                        "className": "bg-card text-card-foreground overflow-hidden rounded-xl ring-1 ring-foreground/10 divide-border divide-y"
                      },
                      "dataSource": {
                        "system": {
                          "endpoint": "/api/admin/mcp/tools",
                          "rowsKey": "tools",
                          "idKey": "name",
                          "query": {
                            "category": "automation"
                          }
                        }
                      },
                      "children": [
                        {
                          "type": "container",
                          "key": "mcp-tools-section-4-1",
                          "element": "div",
                          "props": {
                            "className": "flex flex-col gap-0.5 px-3 py-2"
                          },
                          "children": [
                            {
                              "type": "text",
                              "element": "code",
                              "props": {
                                "className": "text-foreground font-mono text-sm"
                              },
                              "content": "$record.name"
                            },
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground-subtle text-sm"
                              },
                              "content": "$record.description"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "mcp-tools-section-5",
                  "element": "div",
                  "props": {
                    "className": "bg-card text-card-foreground overflow-hidden rounded-xl ring-1 ring-foreground/10 flex flex-col items-start gap-2 p-5"
                  },
                  "visibility": {
                    "record": {
                      "field": "mcpToolCount",
                      "eq": 0
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.mcp.tools.empty"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-foreground-subtle max-w-xl text-md leading-relaxed"
                      },
                      "content": "$t:admin.mcp.tools.emptyHint"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-foreground-subtle max-w-xl text-md italic"
                      },
                      "content": "$t:admin.locked.audit.mcp.exposureNotice"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
