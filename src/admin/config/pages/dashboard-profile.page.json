{
  "id": "dashboard-profile",
  "name": "dashboard-profile",
  "path": "/profile",
  "meta": {
    "title": "$t:admin.meta.profile"
  },
  "components": [
    {
      "component": "console-shell",
      "key": "container-1",
      "vars": {
        "bodyClass": "flex min-w-0 flex-1 flex-col gap-6 px-4 py-4 lg:px-6 md:py-6"
      },
      "slots": {
        "trail": [
          {
            "type": "breadcrumb",
            "separator": "›",
            "props": {
              "className": "min-w-0 flex-initial overflow-hidden [&_ol]:min-w-0 [&_ol]:flex-nowrap [&_li]:shrink-0 [&_li:first-child]:min-w-0 [&_li:first-child]:shrink [&_li:first-child>*]:block [&_li:first-child>*]:truncate [&_li:last-child]:min-w-0 [&_li:last-child]:shrink [&_li:last-child>*]:block [&_li:last-child>*]:truncate max-sm:[&_li:not(:first-child):not(:nth-last-child(-n+2))]:hidden",
              "data-testid": "breadcrumb"
            },
            "derive": "path",
            "home": {
              "label": "$app.label"
            },
            "labels": {
              "profile": "$t:admin.crumb.profile"
            }
          },
          {
            "component": "console-header-end",
            "key": "chrome-end"
          }
        ]
      },
      "children": [
        {
          "type": "container",
          "key": "header",
          "element": "header",
          "props": {
            "className": "flex flex-col gap-1"
          },
          "children": [
            {
              "type": "text",
              "element": "h1",
              "props": {
                "className": "text-foreground text-2xl font-semibold tracking-tight"
              },
              "content": "$t:admin.crumb.profile"
            },
            {
              "type": "text",
              "element": "p",
              "props": {
                "className": "text-muted-foreground max-w-3xl text-sm"
              },
              "content": "$t:admin.profile.blurb"
            }
          ]
        },
        {
          "type": "container",
          "key": "admin-surface-content-2-1",
          "element": "div",
          "props": {
            "className": "flex w-full flex-col"
          },
          "children": [
            {
              "type": "container",
              "key": "profile-identity",
              "element": "div",
              "props": {
                "id": "profile-identity",
                "className": "flex items-center gap-4",
                "role": "group",
                "aria-label": "$t:admin.profile.identity.region"
              },
              "children": [
                {
                  "type": "avatar",
                  "src": "$session.image",
                  "label": "$session.name",
                  "size": "lg",
                  "props": {
                    "data-testid": "profile-avatar",
                    "className": "size-16 text-lg"
                  }
                },
                {
                  "type": "container",
                  "key": "profile-identity-2",
                  "element": "div",
                  "props": {
                    "className": "flex min-w-0 flex-col gap-0.5"
                  },
                  "children": [
                    {
                      "type": "container",
                      "key": "profile-identity-2-1",
                      "element": "div",
                      "props": {
                        "className": "flex items-center gap-2.5"
                      },
                      "children": [
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "className": "text-foreground text-base font-medium"
                          },
                          "session": "name"
                        },
                        {
                          "type": "text",
                          "element": "span",
                          "visibility": {
                            "capability": "edit-operations"
                          },
                          "props": {
                            "className": "border-border bg-muted text-foreground-subtle inline-flex w-fit rounded-full border px-2 py-0.5 text-xs font-medium",
                            "data-testid": "profile-identity-role"
                          },
                          "session": "roleLabel",
                          "content": "$t:admin.shell.role.admin"
                        },
                        {
                          "type": "text",
                          "element": "span",
                          "visibility": {
                            "unlessCapability": "edit-operations"
                          },
                          "props": {
                            "className": "border-border bg-muted text-foreground-subtle inline-flex w-fit rounded-full border px-2 py-0.5 text-xs font-medium",
                            "data-testid": "profile-identity-role"
                          },
                          "session": "roleLabel",
                          "content": "$t:admin.shell.role.viewer"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-foreground-subtle text-md",
                        "data-testid": "profile-identity-email"
                      },
                      "session": "email"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "key": "profile-rows",
              "element": "section",
              "props": {
                "id": "profile-rows",
                "className": "border-border flex flex-col border-t",
                "aria-label": "$t:admin.profile.rows.region"
              },
              "children": [
                {
                  "type": "container",
                  "key": "profile-rows-1",
                  "element": "div",
                  "props": {
                    "className": "grid grid-cols-1 gap-y-2.5 border-b border-border py-4 sm:grid-cols-[168px_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-0"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-foreground block text-base font-medium sm:leading-8"
                      },
                      "content": "$t:admin.profile.picture.label"
                    },
                    {
                      "type": "container",
                      "key": "profile-rows-1-2",
                      "element": "div",
                      "props": {
                        "className": "flex min-w-0 flex-col gap-2"
                      },
                      "children": [
                        {
                          "type": "container",
                          "key": "profile-rows-1-2-1",
                          "element": "div",
                          "props": {
                            "className": "grid grid-cols-1 items-start gap-x-6 gap-y-2 sm:grid-cols-[minmax(0,26rem)_max-content]"
                          },
                          "children": [
                            {
                              "type": "text",
                              "element": "p",
                              "props": {
                                "className": "text-foreground-subtle text-sm"
                              },
                              "content": "$t:admin.profile.picture.hint"
                            },
                            {
                              "type": "container",
                              "key": "profile-rows-1-2-1-2",
                              "element": "div",
                              "props": {
                                "className": "flex items-start gap-2"
                              },
                              "children": [
                                {
                                  "type": "file-upload",
                                  "accept": "image/png,image/jpeg,image/webp",
                                  "dropZone": false,
                                  "maxFileSize": 5242880,
                                  "uploadAction": "/api/account/avatar",
                                  "onSuccess": {
                                    "type": "toast",
                                    "variant": "success",
                                    "message": "$t:admin.profile.picture.uploaded",
                                    "status": {
                                      "target": "profile-picture-status",
                                      "message": "$t:admin.profile.picture.uploaded"
                                    },
                                    "refetch": "profile-identity"
                                  },
                                  "onError": {
                                    "type": "toast",
                                    "variant": "destructive",
                                    "message": "$t:admin.profile.picture.uploadFailed"
                                  },
                                  "props": {
                                    "data-testid": "profile-picture-upload",
                                    "label": "$t:admin.profile.picture.upload",
                                    "className": "w-fit [&_input[type=file]]:sr-only"
                                  }
                                },
                                {
                                  "type": "button",
                                  "variant": "ghost",
                                  "content": "$t:admin.profile.picture.remove",
                                  "props": {
                                    "data-testid": "profile-picture-remove",
                                    "className": "w-fit text-muted-foreground hover:text-foreground"
                                  },
                                  "confirm": {
                                    "title": "$t:admin.profile.picture.removeConfirm.title",
                                    "message": "$t:admin.profile.picture.removeConfirm.message",
                                    "confirmLabel": "$t:admin.profile.picture.removeConfirm.confirm",
                                    "cancelLabel": "$t:admin.profile.picture.removeConfirm.cancel"
                                  },
                                  "action": {
                                    "type": "fetch",
                                    "url": "/api/account/avatar",
                                    "method": "DELETE",
                                    "onSuccess": {
                                      "type": "toast",
                                      "variant": "success",
                                      "message": "$t:admin.profile.picture.removed",
                                      "status": {
                                        "target": "profile-picture-status",
                                        "message": "$t:admin.profile.picture.removed"
                                      },
                                      "refetch": "profile-identity"
                                    },
                                    "onError": {
                                      "type": "toast",
                                      "variant": "destructive",
                                      "message": "$t:admin.profile.picture.removeFailed"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "id": "profile-picture-status",
                            "className": "text-foreground-subtle text-sm empty:hidden!",
                            "data-testid": "profile-picture-status"
                          },
                          "content": ""
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "profile-rows-2",
                  "element": "div",
                  "props": {
                    "className": "grid grid-cols-1 gap-y-2.5 border-b border-border py-4 sm:grid-cols-[168px_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-0"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-foreground block text-base font-medium sm:leading-8"
                      },
                      "content": "$t:admin.field.displayName"
                    },
                    {
                      "type": "container",
                      "key": "profile-rows-2-2",
                      "element": "div",
                      "props": {
                        "className": "flex min-w-0 flex-col gap-2"
                      },
                      "children": [
                        {
                          "type": "form",
                          "props": {
                            "className": "grid grid-cols-1 items-start gap-x-6 border-0 bg-transparent p-0 rounded-none sm:grid-cols-[minmax(0,26rem)_max-content] [&_label>span:first-child]:sr-only",
                            "aria-label": "$t:admin.profile.displayName.formRegion"
                          },
                          "endpoint": {
                            "url": "/api/auth/update-user",
                            "method": "POST",
                            "responseEnvelope": "better-auth",
                            "submitLabel": "$t:admin.profile.displayName.submit",
                            "submitVariant": "outline",
                            "onSuccess": {
                              "type": "toast",
                              "variant": "success",
                              "message": "$t:admin.profile.displayName.saved",
                              "status": {
                                "target": "profile-name-status",
                                "message": "$t:admin.profile.displayName.saved"
                              }
                            },
                            "onError": {
                              "type": "toast",
                              "variant": "destructive",
                              "message": "$t:admin.profile.displayName.failed"
                            }
                          },
                          "fields": [
                            {
                              "field": "name",
                              "control": "text",
                              "autocomplete": "name",
                              "label": "$t:admin.field.displayName",
                              "defaultValue": "$session.name",
                              "description": "$t:admin.profile.displayName.hint"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "id": "profile-name-status",
                            "className": "text-foreground-subtle text-sm empty:hidden!",
                            "data-testid": "profile-name-status"
                          },
                          "content": ""
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "profile-rows-3",
                  "element": "div",
                  "props": {
                    "className": "grid grid-cols-1 gap-y-2.5 border-b border-border py-4 sm:grid-cols-[168px_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-0"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-foreground block text-base font-medium sm:leading-8"
                      },
                      "content": "$t:admin.field.email"
                    },
                    {
                      "type": "container",
                      "key": "profile-rows-3-2",
                      "element": "div",
                      "props": {
                        "className": "flex min-w-0 flex-col gap-2"
                      },
                      "children": [
                        {
                          "type": "form",
                          "props": {
                            "className": "grid grid-cols-1 items-start gap-x-6 border-0 bg-transparent p-0 rounded-none sm:grid-cols-[minmax(0,26rem)_max-content] [&_label>span:first-child]:sr-only",
                            "aria-label": "$t:admin.profile.email.formRegion"
                          },
                          "endpoint": {
                            "url": "/api/auth/change-email",
                            "method": "POST",
                            "responseEnvelope": "better-auth",
                            "submitLabel": "$t:admin.profile.email.submit",
                            "submitVariant": "outline",
                            "onSuccess": {
                              "type": "toast",
                              "variant": "success",
                              "message": "$t:admin.profile.email.sent",
                              "status": {
                                "target": "profile-email-status",
                                "message": "$t:admin.profile.email.sentDetail"
                              }
                            },
                            "onError": {
                              "type": "toast",
                              "variant": "destructive",
                              "message": "$t:admin.profile.email.failed"
                            }
                          },
                          "fields": [
                            {
                              "field": "newEmail",
                              "control": "email",
                              "label": "$t:admin.field.newEmail",
                              "defaultValue": "$session.email",
                              "description": "$t:admin.profile.email.hint"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "id": "profile-email-status",
                            "className": "text-foreground-subtle text-sm empty:hidden!",
                            "data-testid": "profile-email-status"
                          },
                          "content": ""
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "profile-rows-4",
                  "element": "div",
                  "props": {
                    "className": "grid grid-cols-1 gap-y-2.5 border-b border-border py-4 sm:grid-cols-[168px_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-0"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-foreground block text-base font-medium sm:leading-8"
                      },
                      "content": "$t:admin.field.password"
                    },
                    {
                      "type": "container",
                      "key": "profile-rows-4-2",
                      "element": "div",
                      "props": {
                        "className": "flex min-w-0 flex-col gap-2"
                      },
                      "children": [
                        {
                          "type": "form",
                          "props": {
                            "className": "grid grid-cols-1 items-start gap-x-6 border-0 bg-transparent p-0 rounded-none sm:grid-cols-[minmax(0,26rem)_max-content] sm:grid-cols-[minmax(0,12.25rem)_minmax(0,12.25rem)_max-content]",
                            "aria-label": "$t:admin.profile.password.formRegion"
                          },
                          "endpoint": {
                            "url": "/api/auth/change-password",
                            "method": "POST",
                            "responseEnvelope": "better-auth",
                            "submitLabel": "$t:admin.profile.password.submit",
                            "submitVariant": "outline",
                            "onSuccess": {
                              "type": "toast",
                              "variant": "success",
                              "message": "$t:admin.profile.password.saved",
                              "status": {
                                "target": "profile-password-status",
                                "message": "$t:admin.profile.password.saved"
                              }
                            },
                            "onError": {
                              "type": "toast",
                              "variant": "destructive",
                              "message": "$t:admin.profile.password.failed"
                            }
                          },
                          "fields": [
                            {
                              "field": "currentPassword",
                              "control": "password",
                              "autocomplete": "current-password",
                              "label": "$t:admin.field.currentPassword"
                            },
                            {
                              "field": "newPassword",
                              "control": "password",
                              "autocomplete": "new-password",
                              "label": "$t:admin.field.newPassword"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "id": "profile-password-status",
                            "className": "text-foreground-subtle text-sm empty:hidden!",
                            "data-testid": "profile-password-status"
                          },
                          "content": ""
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "profile-rows-5",
                  "element": "div",
                  "props": {
                    "className": "grid grid-cols-1 gap-y-2.5 border-b border-border py-4 sm:grid-cols-[168px_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-0"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-foreground block text-base font-medium sm:leading-8"
                      },
                      "content": "$t:admin.profile.language.label"
                    },
                    {
                      "type": "container",
                      "key": "profile-rows-5-2",
                      "element": "div",
                      "props": {
                        "className": "flex min-w-0 flex-col gap-2"
                      },
                      "children": [
                        {
                          "type": "form",
                          "props": {
                            "className": "grid grid-cols-1 items-start gap-x-6 border-0 bg-transparent p-0 rounded-none sm:grid-cols-[minmax(0,26rem)_max-content] [&_label>span:first-child]:sr-only",
                            "aria-label": "$t:admin.profile.language.formRegion",
                            "data-testid": "profile-language"
                          },
                          "endpoint": {
                            "url": "/api/auth/update-user",
                            "method": "POST",
                            "responseEnvelope": "better-auth",
                            "submitOn": "change",
                            "onSuccess": {
                              "type": "toast",
                              "variant": "success",
                              "message": "$t:admin.profile.language.saved",
                              "reload": true
                            },
                            "onError": {
                              "type": "toast",
                              "variant": "destructive",
                              "message": "$t:admin.profile.language.failed"
                            }
                          },
                          "fields": [
                            {
                              "field": "language",
                              "control": "select",
                              "label": "$t:admin.profile.language.label",
                              "defaultValue": "$session.language",
                              "description": "$t:admin.profile.language.hint",
                              "options": [
                                {
                                  "value": "en-US",
                                  "label": "English"
                                },
                                {
                                  "value": "fr-FR",
                                  "label": "Français"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "id": "profile-language-status",
                            "className": "text-foreground-subtle text-sm empty:hidden!",
                            "data-testid": "profile-language-status"
                          },
                          "content": ""
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "profile-rows-6",
                  "element": "div",
                  "props": {
                    "className": "grid grid-cols-1 gap-y-2.5 border-b border-border py-4 sm:grid-cols-[168px_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-0"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h2",
                      "props": {
                        "className": "text-foreground block text-base font-medium sm:leading-8"
                      },
                      "content": "$t:admin.profile.notifications.label"
                    },
                    {
                      "type": "container",
                      "key": "profile-rows-6-2",
                      "element": "div",
                      "props": {
                        "className": "flex min-w-0 flex-col gap-2"
                      },
                      "children": [
                        {
                          "type": "form",
                          "props": {
                            "className": "grid grid-cols-1 items-start gap-x-6 border-0 bg-transparent p-0 rounded-none sm:grid-cols-[minmax(0,26rem)_max-content]",
                            "aria-label": "$t:admin.profile.notifications.automationAlerts.formRegion",
                            "data-testid": "profile-automation-alerts"
                          },
                          "endpoint": {
                            "url": "/api/auth/update-user",
                            "method": "POST",
                            "responseEnvelope": "better-auth",
                            "submitOn": "change",
                            "onSuccess": {
                              "type": "toast",
                              "variant": "success",
                              "message": "$t:admin.profile.notifications.saved",
                              "status": {
                                "target": "profile-automation-alerts-status",
                                "message": "$t:admin.profile.notifications.saved"
                              }
                            },
                            "onError": {
                              "type": "toast",
                              "variant": "destructive",
                              "message": "$t:admin.profile.notifications.failed"
                            }
                          },
                          "fields": [
                            {
                              "field": "notifyAutomationAlerts",
                              "control": "switch",
                              "label": "$t:admin.profile.notifications.automationAlerts.label",
                              "defaultValue": "$session.notifyAutomationAlerts",
                              "description": "$t:admin.profile.notifications.automationAlerts.hint"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "id": "profile-automation-alerts-status",
                            "className": "text-foreground-subtle text-sm empty:hidden!",
                            "data-testid": "profile-automation-alerts-status"
                          },
                          "content": ""
                        },
                        {
                          "type": "form",
                          "props": {
                            "className": "grid grid-cols-1 items-start gap-x-6 border-0 bg-transparent p-0 rounded-none sm:grid-cols-[minmax(0,26rem)_max-content]",
                            "aria-label": "$t:admin.profile.notifications.weeklyDigest.formRegion",
                            "data-testid": "profile-weekly-digest"
                          },
                          "endpoint": {
                            "url": "/api/auth/update-user",
                            "method": "POST",
                            "responseEnvelope": "better-auth",
                            "submitOn": "change",
                            "onSuccess": {
                              "type": "toast",
                              "variant": "success",
                              "message": "$t:admin.profile.notifications.saved",
                              "status": {
                                "target": "profile-weekly-digest-status",
                                "message": "$t:admin.profile.notifications.saved"
                              }
                            },
                            "onError": {
                              "type": "toast",
                              "variant": "destructive",
                              "message": "$t:admin.profile.notifications.failed"
                            }
                          },
                          "fields": [
                            {
                              "field": "notifyWeeklyDigest",
                              "control": "switch",
                              "label": "$t:admin.profile.notifications.weeklyDigest.label",
                              "defaultValue": "$session.notifyWeeklyDigest",
                              "description": "$t:admin.profile.notifications.weeklyDigest.hint"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "id": "profile-weekly-digest-status",
                            "className": "text-foreground-subtle text-sm empty:hidden!",
                            "data-testid": "profile-weekly-digest-status"
                          },
                          "content": ""
                        },
                        {
                          "type": "text",
                          "element": "p",
                          "props": {
                            "className": "text-foreground-subtle text-sm"
                          },
                          "content": "$t:admin.profile.notifications.hint"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "profile-cloud-account",
