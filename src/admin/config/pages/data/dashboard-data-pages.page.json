{
  "id": "dashboard-data-pages",
  "name": "dashboard-data-pages",
  "path": "/analytics",
  "meta": {
    "title": "$t:admin.meta.pages"
  },
  "window": {
    "default": "30d",
    "presets": [
      {
        "id": "30d"
      }
    ]
  },
  "components": [
    {
      "component": "console-shell",
      "key": "container-1",
      "vars": {
        "bodyClass": "flex min-w-0 flex-1 flex-col gap-6 px-4 py-4 lg:px-6 md:py-6"
      },
      "slots": {
        "trail": [
          {
            "type": "breadcrumb",
            "separator": "›",
            "props": {
              "className": "min-w-0 flex-initial overflow-hidden [&_ol]:min-w-0 [&_ol]:flex-nowrap [&_li]:shrink-0 [&_li:first-child]:min-w-0 [&_li:first-child]:shrink [&_li:first-child>*]:block [&_li:first-child>*]:truncate [&_li:last-child]:min-w-0 [&_li:last-child]:shrink [&_li:last-child>*]:block [&_li:last-child>*]:truncate max-sm:[&_li:not(:first-child):not(:nth-last-child(-n+2))]:hidden",
              "data-testid": "breadcrumb"
            },
            "derive": "path",
            "home": {
              "label": "$app.label"
            },
            "labels": {
              "analytics": "$t:admin.crumb.analytics"
            }
          },
          {
            "component": "console-header-end",
            "key": "chrome-end"
          }
        ]
      },
      "children": [
        {
          "type": "container",
          "key": "admin-surface-content-2-1",
          "element": "div",
          "children": [
            {
              "type": "container",
              "key": "header",
              "element": "header",
              "props": {
                "className": "flex flex-col gap-1"
              },
              "children": [
                {
                  "type": "text",
                  "element": "h1",
                  "props": {
                    "className": "text-foreground text-2xl font-semibold tracking-tight"
                  },
                  "content": "$t:admin.pages.heading"
                },
                {
                  "type": "text",
                  "element": "p",
                  "props": {
                    "className": "text-muted-foreground max-w-3xl text-sm"
                  },
                  "content": "$t:admin.pages.blurb"
                }
              ],
              "visibility": {
                "declares": "analytics"
              }
            },
            {
              "type": "container",
              "key": "header-2",
              "element": "header",
              "props": {
                "className": "flex flex-col gap-1"
              },
              "children": [
                {
                  "type": "text",
                  "element": "h1",
                  "props": {
                    "className": "text-foreground text-2xl font-semibold tracking-tight"
                  },
                  "content": "$t:admin.pages.heading"
                },
                {
                  "type": "text",
                  "element": "p",
                  "props": {
                    "className": "text-muted-foreground max-w-3xl text-sm"
                  },
                  "content": "$t:admin.pages.blurbDisabled"
                }
              ],
              "visibility": {
                "unlessDeclares": "analytics"
              }
            }
          ]
        },
        {
          "type": "container",
          "key": "analytics-off",
          "element": "section",
          "props": {
            "aria-labelledby": "analytics-off-title",
            "className": "flex max-w-3xl flex-col gap-1 rounded-xl border border-border bg-card px-4 py-4 text-sm"
          },
          "visibility": {
            "unlessDeclares": "analytics"
          },
          "children": [
            {
              "type": "text",
              "element": "h2",
              "props": {
                "id": "analytics-off-title",
                "className": "text-base font-medium text-foreground"
              },
              "content": "$t:admin.pages.off.title"
            },
            {
              "type": "container",
              "element": "div",
              "props": {
                "className": "text-muted-foreground"
              },
              "children": [
                {
                  "type": "text",
                  "element": "span",
                  "content": "$t:admin.pages.off.guidance.before"
                },
                {
                  "type": "text",
                  "element": "code",
                  "props": {
                    "className": "mx-1 rounded-sm bg-muted px-1 py-0.5 font-mono text-xs text-foreground"
                  },
                  "content": "analytics: true"
                },
                {
                  "type": "text",
                  "element": "span",
                  "content": "$t:admin.pages.off.guidance.after"
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "key": "audience",
          "element": "div",
          "props": {
            "className": "flex min-w-0 flex-col gap-6"
          },
          "visibility": {
            "declares": "analytics",
            "capability": "administer-accounts"
          },
          "children": [
            {
              "type": "container",
              "key": "admin-surface-content-2-1-2-1",
              "element": "div",
              "visibility": {
                "declares": "analytics"
              },
              "props": {
                "className": "flex flex-col gap-8 pt-2"
              },
              "children": [
                {
                  "type": "container",
                  "key": "metrics-region",
                  "element": "div",
                  "props": {
                    "role": "region",
                    "aria-label": "$t:admin.pages.metrics.region",
                    "className": "grid grid-cols-1 gap-4 sm:grid-cols-3"
                  },
                  "children": [
                    {
                      "component": "console-section-card",
                      "key": "section-card",
                      "vars": {
                        "label": "$t:admin.analytics.pageViews",
                        "dataSource": {
                          "system": {
                            "endpoint": "/api/analytics/overview",
                            "valuePath": "summary.pageViews",
                            "query": {
                              "from": "$window.start",
                              "to": "$window.end",
                              "granularity": "$window.granularity"
                            }
                          }
                        },
                        "kpiFormat": {
                          "type": "number"
                        }
                      }
                    },
                    {
                      "component": "console-section-card",
                      "key": "section-card-2",
                      "vars": {
                        "label": "$t:admin.analytics.uniqueVisitors",
                        "dataSource": {
                          "system": {
                            "endpoint": "/api/analytics/overview",
                            "valuePath": "summary.uniqueVisitors",
                            "query": {
                              "from": "$window.start",
                              "to": "$window.end",
                              "granularity": "$window.granularity"
                            }
                          }
                        },
                        "kpiFormat": {
                          "type": "number"
                        }
                      }
                    },
                    {
                      "component": "console-section-card",
                      "key": "section-card-3",
                      "vars": {
                        "label": "$t:admin.analytics.sessions",
                        "dataSource": {
                          "system": {
                            "endpoint": "/api/analytics/overview",
                            "valuePath": "summary.sessions",
                            "query": {
                              "from": "$window.start",
                              "to": "$window.end",
                              "granularity": "$window.granularity"
                            }
                          }
                        },
                        "kpiFormat": {
                          "type": "number"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "chart",
                  "props": {
                    "aria-label": "$t:admin.pages.trend.region"
                  },
                  "dataSource": {
                    "system": {
                      "endpoint": "/api/analytics/overview",
                      "rowsKey": "timeSeries",
                      "query": {
                        "from": "$window.start",
                        "to": "$window.end",
                        "granularity": "$window.granularity"
                      }
                    }
                  },
                  "chartType": "area",
                  "xAxis": {
                    "field": "period",
                    "format": "date"
                  },
                  "yAxis": {
                    "field": "pageViews",
                    "gridLines": true
                  },
                  "series": [
                    {
                      "field": "pageViews",
                      "label": "$t:admin.analytics.pageViews"
                    },
                    {
                      "field": "uniqueVisitors",
                      "label": "$t:admin.analytics.uniqueVisitors"
                    },
                    {
                      "field": "sessions",
                      "label": "$t:admin.analytics.sessions"
                    }
                  ],
                  "emptyState": {
                    "role": "region",
                    "name": "$t:admin.common.noData",
                    "title": "$t:admin.analytics.noVisits",
                    "description": "$t:admin.analytics.noVisits.guidance"
                  }
                },
                {
                  "component": "console-grid",
                  "key": "grid",
                  "vars": {
                    "ariaLabel": "$t:admin.pages.top.region",
                    "dataSource": {
                      "system": {
                        "endpoint": "/api/analytics/pages",
                        "rowsKey": "pages",
                        "idKey": "path",
                        "query": {
                          "from": "$window.start",
                          "to": "$window.end"
                        }
                      }
                    },
                    "columns": [
                      {
                        "field": "path",
                        "label": "$t:admin.analytics.page"
                      },
                      {
                        "field": "pageViews",
                        "label": "$t:admin.analytics.views",
                        "align": "right"
                      },
                      {
                        "field": "uniqueVisitors",
                        "label": "$t:admin.analytics.visitors",
                        "align": "right"
                      }
                    ],
                    "emptyMessage": "$t:admin.analytics.noPages",
                    "viewOptions": "toolbar",
                    "emptyDescription": "$t:admin.analytics.noPages.guidance"
                  }
                },
                {
                  "type": "container",
                  "key": "acquisition-heading",
                  "element": "section",
                  "props": {
                    "className": "flex flex-col gap-3",
                    "aria-label": "$t:admin.pages.acquisition.heading"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h3",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.pages.acquisition.heading"
                    },
                    {
                      "type": "container",
                      "key": "acquisition-heading-2",
                      "props": {
                        "className": "grid grid-cols-1 gap-4 lg:grid-cols-2"
                      },
                      "children": [
                        {
                          "component": "console-grid",
                          "key": "grid-2",
                          "vars": {
                            "ariaLabel": "$t:admin.pages.referrers.region",
                            "dataSource": {
                              "system": {
                                "endpoint": "/api/analytics/referrers",
                                "rowsKey": "referrers",
                                "idKey": "domain",
                                "query": {
                                  "from": "$window.start",
                                  "to": "$window.end"
                                }
                              }
                            },
                            "columns": [
                              {
                                "field": "domain",
                                "label": "$t:admin.analytics.referrer"
                              },
                              {
                                "field": "pageViews",
                                "label": "$t:admin.analytics.views",
                                "align": "right"
                              },
                              {
                                "field": "uniqueVisitors",
                                "label": "$t:admin.analytics.visitors",
                                "align": "right"
                              }
                            ],
                            "emptyMessage": "$t:admin.pages.noReferrers",
                            "viewOptions": "toolbar",
                            "emptyDescription": "$t:admin.pages.noReferrers.guidance"
                          }
                        },
                        {
                          "component": "console-grid",
                          "key": "grid-3",
                          "vars": {
                            "ariaLabel": "$t:admin.pages.campaigns.region",
                            "dataSource": {
                              "system": {
                                "endpoint": "/api/analytics/campaigns",
                                "rowsKey": "campaigns",
                                "idKey": "campaign",
                                "query": {
                                  "from": "$window.start",
                                  "to": "$window.end"
                                }
                              }
                            },
                            "columns": [
                              {
                                "field": "campaign",
                                "label": "$t:admin.analytics.campaign"
                              },
                              {
                                "field": "source",
                                "label": "$t:admin.common.source"
                              },
                              {
                                "field": "medium",
                                "label": "$t:admin.analytics.medium"
                              },
                              {
                                "field": "pageViews",
                                "label": "$t:admin.analytics.views",
                                "align": "right"
                              }
                            ],
                            "emptyMessage": "$t:admin.pages.noCampaigns",
                            "viewOptions": "toolbar",
                            "emptyDescription": "$t:admin.pages.noCampaigns.guidance"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "technology-heading",
                  "element": "section",
                  "props": {
                    "className": "flex flex-col gap-3",
                    "aria-label": "$t:admin.pages.technology.heading"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h3",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.pages.technology.heading"
                    },
                    {
                      "type": "container",
                      "key": "technology-heading-2",
                      "props": {
                        "className": "grid grid-cols-1 gap-4 lg:grid-cols-3"
                      },
                      "children": [
                        {
                          "component": "console-grid",
                          "key": "grid-4",
                          "vars": {
                            "ariaLabel": "$t:admin.pages.devices.region",
                            "dataSource": {
                              "system": {
                                "endpoint": "/api/analytics/devices",
                                "rowsKey": "deviceTypes",
                                "idKey": "name",
                                "query": {
                                  "from": "$window.start",
                                  "to": "$window.end"
                                }
                              }
                            },
                            "columns": [
                              {
                                "field": "name",
                                "label": "$t:admin.common.name"
                              },
                              {
                                "field": "count",
                                "label": "$t:admin.analytics.visits",
                                "align": "right"
                              },
                              {
                                "field": "percentage",
                                "label": "$t:admin.analytics.share",
                                "align": "right"
                              }
                            ],
                            "emptyMessage": "$t:admin.analytics.noDevices",
                            "viewOptions": "toolbar",
                            "emptyDescription": "$t:admin.analytics.noDevices.guidance"
                          }
                        },
                        {
                          "component": "console-grid",
                          "key": "grid-5",
                          "vars": {
                            "ariaLabel": "$t:admin.pages.browsers.region",
                            "dataSource": {
                              "system": {
                                "endpoint": "/api/analytics/devices",
                                "rowsKey": "browsers",
                                "idKey": "name",
                                "query": {
                                  "from": "$window.start",
                                  "to": "$window.end"
                                }
                              }
                            },
                            "columns": [
                              {
                                "field": "name",
                                "label": "$t:admin.common.name"
                              },
                              {
                                "field": "count",
                                "label": "$t:admin.analytics.visits",
                                "align": "right"
                              },
                              {
                                "field": "percentage",
                                "label": "$t:admin.analytics.share",
                                "align": "right"
                              }
                            ],
                            "emptyMessage": "$t:admin.analytics.noBrowsers",
                            "viewOptions": "toolbar",
                            "emptyDescription": "$t:admin.analytics.noBrowsers.guidance"
                          }
                        },
                        {
                          "component": "console-grid",
                          "key": "grid-6",
                          "vars": {
                            "ariaLabel": "$t:admin.pages.os.region",
                            "dataSource": {
                              "system": {
                                "endpoint": "/api/analytics/devices",
                                "rowsKey": "operatingSystems",
                                "idKey": "name",
                                "query": {
                                  "from": "$window.start",
                                  "to": "$window.end"
                                }
                              }
                            },
                            "columns": [
                              {
                                "field": "name",
                                "label": "$t:admin.common.name"
                              },
                              {
                                "field": "count",
                                "label": "$t:admin.analytics.visits",
                                "align": "right"
                              },
                              {
                                "field": "percentage",
                                "label": "$t:admin.analytics.share",
                                "align": "right"
                              }
                            ],
                            "emptyMessage": "$t:admin.analytics.noOs",
                            "viewOptions": "toolbar",
                            "emptyDescription": "$t:admin.analytics.noOs.guidance"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "container",
                  "key": "events-heading",
                  "element": "section",
                  "props": {
                    "className": "flex flex-col gap-3",
                    "aria-label": "$t:admin.pages.events.heading"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "h3",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.pages.events.heading"
                    },
                    {
                      "component": "console-grid",
                      "key": "grid-7",
                      "vars": {
                        "ariaLabel": "$t:admin.pages.events.heading",
                        "dataSource": {
                          "system": {
                            "endpoint": "/api/analytics/events",
                            "rowsKey": "events",
                            "idKey": "id",
                            "query": {
                              "from": "$window.start",
                              "to": "$window.end"
                            }
                          }
                        },
                        "columns": [
                          {
                            "field": "event_name",
                            "label": "$t:admin.analytics.event"
                          },
                          {
                            "field": "event_type",
                            "label": "$t:admin.common.type"
                          },
                          {
                            "field": "timestamp",
                            "label": "$t:admin.analytics.recorded",
                            "format": "datetime"
                          }
                        ],
                        "emptyMessage": "$t:admin.analytics.noEvents",
                        "viewOptions": "toolbar",
                        "emptyDescription": "$t:admin.analytics.noEvents.guidance"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
