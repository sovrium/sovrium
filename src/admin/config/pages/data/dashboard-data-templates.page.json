{
  "id": "dashboard-data-templates",
  "name": "dashboard-data-templates",
  "path": "/templates",
  "meta": {
    "title": "$t:admin.meta.templates"
  },
  "requires": ["assets.templates"],
  "dataSource": {
    "system": {
      "endpoint": "/api/admin/templates"
    }
  },
  "components": [
    {
      "component": "console-shell",
      "key": "container-1",
      "vars": {
        "bodyClass": "flex min-w-0 flex-1 flex-col gap-6 px-4 py-4 lg:px-6 md:py-6"
      },
      "slots": {
        "trail": [
          {
            "type": "breadcrumb",
            "separator": "›",
            "props": {
              "className": "min-w-0 flex-initial overflow-hidden [&_ol]:min-w-0 [&_ol]:flex-nowrap [&_li]:shrink-0 [&_li:first-child]:min-w-0 [&_li:first-child]:shrink [&_li:first-child>*]:block [&_li:first-child>*]:truncate [&_li:last-child]:min-w-0 [&_li:last-child]:shrink [&_li:last-child>*]:block [&_li:last-child>*]:truncate max-sm:[&_li:not(:first-child):not(:nth-last-child(-n+2))]:hidden",
              "data-testid": "breadcrumb"
            },
            "derive": "path",
            "home": {
              "label": "$app.label"
            },
            "labels": {
              "templates": "$t:admin.crumb.templates"
            }
          },
          {
            "component": "console-header-end",
            "key": "chrome-end"
          }
        ]
      },
      "children": [
        {
          "type": "container",
          "key": "header",
          "element": "header",
          "props": {
            "className": "flex flex-col gap-1"
          },
          "children": [
            {
              "type": "text",
              "element": "h1",
              "props": {
                "className": "text-foreground text-2xl font-semibold tracking-tight"
              },
              "content": "$t:admin.templates.heading"
            },
            {
              "type": "text",
              "element": "p",
              "props": {
                "className": "text-muted-foreground max-w-3xl text-sm"
              },
              "content": "$t:admin.templates.blurb"
            }
          ]
        },
        {
          "type": "container",
          "key": "admin-surface-content-2-2",
          "element": "div",
          "props": {
            "className": "flex flex-col gap-4 pt-2"
          },
          "children": [
            {
              "type": "container",
              "key": "admin-surface-content-2-2-1",
              "element": "div",
              "props": {},
              "visibility": {
                "record": {
                  "field": "templates",
                  "isNotEmpty": true
                }
              },
              "children": [
                {
                  "type": "list",
                  "props": {
                    "aria-label": "$t:admin.templates.list.region",
                    "data-testid": "templates-list",
                    "className": "bg-card text-card-foreground overflow-hidden rounded-xl ring-1 ring-foreground/10 divide-border divide-y"
                  },
                  "dataSource": {
                    "system": {
                      "endpoint": "/api/admin/templates",
                      "rowsKey": "templates",
                      "idKey": "path"
                    }
                  },
                  "children": [
                    {
                      "type": "link",
                      "props": {
                        "href": "/templates/$record.previewPath",
                        "data-testid": "template-row-$record.path",
                        "className": "hover:bg-background-hover flex flex-col gap-1 px-4 py-3 no-underline md:flex-row md:items-baseline md:justify-between md:gap-6"
                      },
                      "children": [
                        {
                          "type": "container",
                          "key": "admin-surface-content-2-2-1-1",
                          "element": "div",
                          "props": {
                            "className": "flex min-w-0 flex-col gap-0.5"
                          },
                          "children": [
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground font-mono text-sm break-all"
                              },
                              "content": "$record.path"
                            },
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground-subtle text-sm empty:hidden"
                              },
                              "content": "$record.description"
                            },
                            {
                              "type": "container",
                              "key": "admin-surface-content-2-2-1-1-3",
                              "element": "div",
                              "props": {
                                "className": "text-foreground-subtle flex flex-wrap gap-1 text-sm"
                              },
                              "visibility": {
                                "record": {
                                  "field": "usedBy",
                                  "isNotEmpty": true
                                }
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "element": "span",
                                  "props": {
                                    "className": ""
                                  },
                                  "content": "$t:admin.templates.row.readBy"
                                },
                                {
                                  "type": "text",
                                  "element": "span",
                                  "props": {
                                    "className": "font-mono"
                                  },
                                  "content": "$record.usedBy"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "container",
                          "key": "admin-surface-content-2-2-1-2",
                          "element": "div",
                          "props": {
                            "className": "flex shrink-0 items-baseline gap-3"
                          },
                          "children": [
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground text-sm"
                              },
                              "content": "$t:admin.templates.row.sample",
                              "visibility": {
                                "record": {
                                  "field": "hasSampleData",
                                  "eq": true
                                }
                              }
                            },
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground-subtle text-sm"
                              },
                              "content": "$t:admin.templates.row.noSample",
                              "visibility": {
                                "record": {
                                  "field": "hasSampleData",
                                  "eq": false
                                }
                              }
                            },
                            {
                              "type": "text",
                              "element": "span",
                              "props": {
                                "className": "text-foreground-subtle font-mono text-sm"
                              },
                              "content": "$record.kind"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "key": "admin-surface-content-2-2-2",
              "element": "div",
              "props": {},
              "visibility": {
                "record": {
                  "field": "templates",
                  "isEmpty": true
                }
              },
              "children": [
                {
                  "type": "container",
                  "key": "empty-title",
                  "element": "section",
                  "props": {
                    "aria-label": "$t:admin.templates.empty.title",
                    "className": "bg-card text-card-foreground overflow-hidden rounded-xl ring-1 ring-foreground/10 flex min-h-64 flex-col items-center justify-center gap-2 p-10 text-center"
                  },
                  "children": [
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-foreground text-md font-medium"
                      },
                      "content": "$t:admin.templates.empty.title"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-muted-foreground max-w-md text-md leading-relaxed"
                      },
                      "content": "$t:admin.templates.empty.body"
                    },
                    {
                      "type": "text",
                      "element": "p",
                      "props": {
                        "className": "text-foreground-subtle mt-1 max-w-md text-md italic"
                      },
                      "content": "$t:admin.templates.empty.hint"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
