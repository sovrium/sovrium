# Sovrium environment variables — this template
# Copy to .env and uncomment what you need. `sovrium start app.yaml` runs
# zero-config with embedded SQLite and local file storage — with the MCP
# server off until you switch it on below.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# The public https address of the app. Leave it unset on your own machine; in
# production set your real origin. A localhost BASE_URL on a server turns off
# the cross-site request (CSRF) check and drops the Secure cookie flag.
# BASE_URL=https://your-domain.example
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── Auth ──────────────────────────────────────────────────────────────
# Sign-up is closed, so the first admin comes from these two variables on
# the first start — or run: sovrium admin create <email>
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_PASSWORD=

# The encryption key protects stored credentials. Sovrium generates and keeps
# one on first start; set it yourself on a host whose disk is rebuilt on each
# deploy. Generate it with: sovrium secret generate encryption
# SOVRIUM_ENCRYPTION_KEY=
# Optional, best left unset: the session secret derives from the key above.
# Set AUTH_SECRET and it wins, and the two then rotate independently.
# AUTH_SECRET=

# ── MCP ───────────────────────────────────────────────────────────────
# The server is switched on here, never in the config. There is no
# credential variable: /mcp reads the API key (x-api-key) or the OAuth
# token (Authorization: Bearer) each request carries.
# MCP_ENABLED=true
# `streamable-http` serves /mcp over HTTP to a client anywhere; `stdio`
# switches the route off.
# MCP_TRANSPORT=streamable-http

# ── Demo data ─────────────────────────────────────────────────────────
# `sovrium seed` creates the accounts of seed/users.yaml (an admin, an
# editor and a viewer) with this password. Seeding refuses to run without it.
# Every seeded account shares it, the admin included: pick a strong one, or
# do not seed an app other people can reach.
# SOVRIUM_SEED_PASSWORD=

# ── GitHub (optional) ─────────────────────────────────────────────────
# A token with read access to the repositories your runbooks live in turns on
# the admin's "Import a runbook from GitHub". Without it the app runs and only
# that import is idle.
# GITHUB_TOKEN=
