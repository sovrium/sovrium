# Sovrium environment variables — this template
# Copy to .env and uncomment what you need. `sovrium start app.yaml` runs
# zero-config with embedded SQLite and local file storage.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# The public address of the site; the RSS feed links to it.
# The public https address of the app. Leave it unset on your own machine; in
# production set your real origin. A localhost BASE_URL on a server turns off
# the cross-site request (CSRF) check and drops the Secure cookie flag.
# BASE_URL=https://your-domain.example
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── Auth ──────────────────────────────────────────────────────────────
# Sign-up is closed, so the editor comes from these two variables on the
# first start — or run: sovrium admin create <email>
# AUTH_ADMIN_EMAIL=editor@example.com
# AUTH_ADMIN_PASSWORD=

# The encryption key protects stored credentials. Sovrium generates and keeps
# one on first start; set it yourself on a host whose disk is rebuilt on each
# deploy. Generate it with: sovrium secret generate encryption
# SOVRIUM_ENCRYPTION_KEY=
# Optional, best left unset: the session secret derives from the key above.
# Set AUTH_SECRET and it wins, and the two then rotate independently.
# AUTH_SECRET=

# ── Demo data ─────────────────────────────────────────────────────────
# `sovrium seed` creates the editor's account of seed/users.yaml with this
# password. Seeding refuses to run without it.
# Every seeded account shares it, the admin included: pick a strong one, or
# do not seed an app other people can reach.
# SOVRIUM_SEED_PASSWORD=

# ── AI (the editorial assistant) ──────────────────────────────────────
# The assistant on /admin/ai-editor needs a provider. Without one the rest
# of the site works and the assistant stays silent. Local and free: run
# Ollama (https://ollama.com) and pull a model.
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.1
# Or a cloud provider:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=

# ── Email (operator emails) ───────────────────────────────────────────
# Without SMTP_HOST, no email leaves the app; comments still wait on the
# desk and scheduled posts still go live.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Extra addresses that receive the operator emails (a failed automation),
# comma-separated.
# SOVRIUM_NOTIFY_TO=

# ── Brevo (optional) ──────────────────────────────────────────────────
# An API key of your Brevo account sends each newsletter address to Brevo as a
# contact, for the sending. Without it the addresses stay in the subscribers
# table and only that automation is idle.
# BREVO_API_KEY=
