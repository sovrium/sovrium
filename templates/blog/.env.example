# Sovrium environment variables — this template
# Copy to .env and uncomment what you need. `sovrium start app.yaml` runs
# zero-config with embedded SQLite and local file storage.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# The public address of the site; the RSS feed links to it.
# BASE_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── Auth ──────────────────────────────────────────────────────────────
# Sign-up is closed, so the editor comes from these two variables on the
# first start — or run: sovrium admin create <email>
# Generate the secrets with: sovrium secret generate
# AUTH_SECRET=
# SOVRIUM_ENCRYPTION_KEY=
# AUTH_ADMIN_EMAIL=editor@example.com
# AUTH_ADMIN_PASSWORD=

# ── Demo data ─────────────────────────────────────────────────────────
# `sovrium seed` creates the editor's account of seed/users.yaml with this
# password. Seeding refuses to run without it.
# SOVRIUM_SEED_PASSWORD=

# ── AI (the editorial assistant) ──────────────────────────────────────
# The assistant on /admin/ai-editor needs a provider. Without one the rest
# of the site works and the assistant stays silent. Local and free: run
# Ollama (https://ollama.com) and pull a model.
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.1
# Or a cloud provider:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=

# ── Email (operator emails) ───────────────────────────────────────────
# Without SMTP_HOST, no email leaves the app; comments still wait on the
# desk and scheduled posts still go live.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Extra addresses that receive the operator emails (a failed automation),
# comma-separated.
# SOVRIUM_NOTIFY_TO=
