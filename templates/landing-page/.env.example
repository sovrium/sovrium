# Tablée — environment configuration
# Copy to .env and uncomment what you need. Every variable is optional:
# `sovrium start app.yaml` runs zero-config with embedded SQLite and local
# file storage.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# The public address of the site: the sitemap is built from it. The sharing
# cards are sent on the address each visitor asked for.
# BASE_URL=https://tablee.example
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── The owner ─────────────────────────────────────────────────────────
# Visitors never sign in, and nobody can open an account. The owner, who reads
# the demo requests in the admin (/_admin), comes from these two variables on
# the first start — or run: sovrium admin create <email>
# Generate the secret with: sovrium secret generate
# AUTH_SECRET=
# AUTH_ADMIN_EMAIL=margaux.rey@tablee.example
# AUTH_ADMIN_PASSWORD=Tablee-Demo-Password-2026
