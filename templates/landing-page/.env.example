# Tablée — environment configuration
# Copy to .env and uncomment what you need. Every variable is optional:
# `sovrium start app.yaml` runs zero-config with embedded SQLite and local
# file storage.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# The public address of the site: the sitemap is built from it. The sharing
# cards are sent on the address each visitor asked for.
# BASE_URL=https://tablee.example
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── The owner ─────────────────────────────────────────────────────────
# Visitors never sign in, and nobody can open an account. The owner, who reads
# the demo requests in the admin (/_admin), comes from these two variables on
# the first start — or run: sovrium admin create <email>
# AUTH_ADMIN_EMAIL=margaux.rey@tablee.example
# AUTH_ADMIN_PASSWORD=          # a long password of your own, never a shared one

# The encryption key protects stored credentials. Sovrium generates and keeps
# one on first start; set it yourself on a host whose disk is rebuilt on each
# deploy. Generate it with: sovrium secret generate encryption
# SOVRIUM_ENCRYPTION_KEY=
# Optional, best left unset: the session secret derives from the key above.
# Set AUTH_SECRET and it wins, and the two then rotate independently.
# AUTH_SECRET=

# ── Pipedrive (optional) ──────────────────────────────────────────────
# The API token of your Pipedrive account turns each demo request into a
# person and a lead there. Without it the app runs and every request is still
# kept in the admin.
# PIPEDRIVE_API_TOKEN=
