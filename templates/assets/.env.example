# Sovrium environment variables — this template
# Copy to .env and uncomment what you need. Every variable is OPTIONAL:
# `sovrium start app.yaml` runs zero-config with embedded SQLite and local
# file storage.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# The public https address of the app. Leave it unset on your own machine; in
# production set your real origin. A localhost BASE_URL on a server turns off
# the cross-site request (CSRF) check and drops the Secure cookie flag.
# BASE_URL=https://your-domain.example
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── Auth ──────────────────────────────────────────────────────────────
# Sign-up is closed in this app, so the first administrator comes from these
# two variables on the first start — or run: sovrium admin create <email>
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_PASSWORD=

# The encryption key protects stored credentials. Sovrium generates and keeps
# one on first start; set it yourself on a host whose disk is rebuilt on each
# deploy. Generate it with: sovrium secret generate encryption
# SOVRIUM_ENCRYPTION_KEY=
# Optional, best left unset: the session secret derives from the key above.
# Set AUTH_SECRET and it wins, and the two then rotate independently.
# AUTH_SECRET=

# ── Demo data ─────────────────────────────────────────────────────────
# `sovrium seed` creates the five demo accounts of seed/users.yaml with this
# password. Seeding refuses to run without it.
# Every seeded account shares it, the admin included: pick a strong one, or
# do not seed an app other people can reach.
# SOVRIUM_SEED_PASSWORD=

# ── Email (the operator emails) ───────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Extra addresses that receive the operator emails (a failed automation, for
# instance), comma-separated.
# SOVRIUM_NOTIFY_TO=

# ── Microsoft Teams (optional) ────────────────────────────────────────
# A Microsoft Entra app registration and the ids of a team and one of its
# channels turn on the post of each asset event (a check-out, a repair, a
# return) to that channel. Connect the Microsoft account once from the admin
# console. Without them the app runs and only that automation is idle.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# TEAMS_TEAM_ID=
# TEAMS_CHANNEL_ID=
