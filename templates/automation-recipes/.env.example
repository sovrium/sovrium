# Sovrium environment variables — this template
# Copy to .env and uncomment what you need. Every variable is OPTIONAL except
# LEADS_WEBHOOK_TOKEN: `sovrium start app.yaml` otherwise runs zero-config with
# embedded SQLite and local file storage.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# SOVRIUM_BIND_HOST=localhost           # interface: localhost or an IP literal (0.0.0.0 in a container); replaces HOSTNAME
# The public https address of the app. Leave it unset on your own machine; in
# production set your real origin. A localhost BASE_URL on a server turns off
# the cross-site request (CSRF) check and drops the Secure cookie flag.
# BASE_URL=https://your-domain.example
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── The lead webhook (required) ───────────────────────────────────────
# The bearer token a caller must send to
# /api/automations/capture-lead-from-webhook/webhook. The app refuses to start
# without it. Generate one with: sovrium secret generate
# LEADS_WEBHOOK_TOKEN=

# ── Auth ──────────────────────────────────────────────────────────────
# Sign-up is closed in this app, so the first administrator comes from these
# two variables on the first start — or run: sovrium admin create <email>
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_PASSWORD=

# The encryption key protects stored credentials. Sovrium generates and keeps
# one on first start; set it yourself on a host whose disk is rebuilt on each
# deploy. Generate it with: sovrium secret generate encryption
# SOVRIUM_ENCRYPTION_KEY=
# Optional, best left unset: the session secret derives from the key above.
# Set AUTH_SECRET and it wins, and the two then rotate independently.
# AUTH_SECRET=

# ── Demo data ─────────────────────────────────────────────────────────
# `sovrium seed` creates the two demo accounts of seed/users.yaml with this
# password. Seeding refuses to run without it.
# Every seeded account shares it, the admin included: pick a strong one, or
# do not seed an app other people can reach.
# SOVRIUM_SEED_PASSWORD=

# ── Email ─────────────────────────────────────────────────────────────
# Without SMTP_HOST, the recipes' emails are logged instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Extra addresses that receive the operator emails — a run that failed after
# its retries, for instance — comma-separated.
# SOVRIUM_NOTIFY_TO=

# ── Mistral (optional) ────────────────────────────────────────────────
# An API key of your Mistral account turns on the two-sentence summary of each
# lead that arrives with a message. Without it the app runs and only that
# automation is idle.
# MISTRAL_API_KEY=

# Hosting many apps on one machine, each behind a systemd unit or a socket proxy:
# SOVRIUM_STRICT_PORT=1                   # a busy port refuses to start (implied under systemd)
# SOVRIUM_LISTEN_UNIX=/run/sovrium/app.sock   # serve on a Unix socket (mode 0660) instead of PORT
# SOVRIUM_IDLE_EXIT_SECONDS=900           # exit cleanly once idle this long; at least 30
# SOVRIUM_LOG_FORMAT=json                 # one JSON object per log line, for a log collector
