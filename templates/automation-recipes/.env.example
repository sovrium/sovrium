# Sovrium environment variables — this template
# Copy to .env and uncomment what you need. Every variable is OPTIONAL except
# LEADS_WEBHOOK_TOKEN: `sovrium start app.yaml` otherwise runs zero-config with
# embedded SQLite and local file storage.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# BASE_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── The lead webhook (required) ───────────────────────────────────────
# The bearer token a caller must send to
# /api/automations/capture-lead-from-webhook/webhook. The app refuses to start
# without it. Generate one with: sovrium secret generate
# LEADS_WEBHOOK_TOKEN=

# ── Auth ──────────────────────────────────────────────────────────────
# Sign-up is closed in this app, so the first administrator comes from these
# two variables on the first start — or run: sovrium admin create <email>
# Generate the secrets with: sovrium secret generate
# AUTH_SECRET=
# SOVRIUM_ENCRYPTION_KEY=
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_PASSWORD=

# ── Demo data ─────────────────────────────────────────────────────────
# `sovrium seed` creates the two demo accounts of seed/users.yaml with this
# password. Seeding refuses to run without it.
# SOVRIUM_SEED_PASSWORD=

# ── Email ─────────────────────────────────────────────────────────────
# Without SMTP_HOST, the recipes' emails are logged instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Extra addresses that receive the operator emails — a run that failed after
# its retries, for instance — comma-separated.
# SOVRIUM_NOTIFY_TO=
