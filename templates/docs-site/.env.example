# Docs — environment configuration
#
# Every page is public and the site keeps no data, so it runs with zero
# configuration. Copy to `.env` only if you want to override a default.

# --- Server ----------------------------------------------------------------
# Public address of the site. Set it in production: the sitemap and the links
# in link previews are built from it.
# BASE_URL=https://docs.example.com
# PORT=3000
# SOVRIUM_BIND_HOST=localhost           # interface: localhost or an IP literal (0.0.0.0 in a container); replaces HOSTNAME

# --- Database (optional) ---------------------------------------------------
# The site has no tables, so the database holds nothing of yours. Unset =
# zero-config SQLite (the default).
# DATABASE_URL=postgres://user:pass@localhost:5432/docs

# --- Content ---------------------------------------------------------------
# The pages are plain `.md` files under `content/docs/`, resolved against the
# folder that holds `app.yaml`. There is nothing to configure here: add a file,
# restart, and it has a page.

# Hosting many apps on one machine, each behind a systemd unit or a socket proxy:
# SOVRIUM_STRICT_PORT=1                   # a busy port refuses to start (implied under systemd)
# SOVRIUM_LISTEN_UNIX=/run/sovrium/app.sock   # serve on a Unix socket (mode 0660) instead of PORT
# SOVRIUM_IDLE_EXIT_SECONDS=900           # exit cleanly once idle this long; at least 30
# SOVRIUM_LOG_FORMAT=json                 # one JSON object per log line, for a log collector
