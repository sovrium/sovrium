# Hello World — environment configuration
#
# The app has one page and keeps no data, so it runs with zero configuration.
# Copy to `.env` only if you want to override a default.

# --- Server ----------------------------------------------------------------
# Public address of the app. Set it in production: the sitemap and the links
# in link previews are built from it.
# BASE_URL=https://my-app.example.com
# PORT=3000

# --- Database (optional) ---------------------------------------------------
# The app has no tables yet. Unset = zero-config SQLite (the default); set it
# to use PostgreSQL once you add some.
# DATABASE_URL=postgres://user:pass@localhost:5432/my-app
