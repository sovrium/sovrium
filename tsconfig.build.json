{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // MUST differ from the inherited `tsconfig.json` path. Without this
    // override both configs write the SAME `.tsbuildinfo`, and the two runs
    // have incompatible jobs: `bun run typecheck` is `--noEmit`, this one emits
    // declarations. Sharing one cache made each invalidate the other's work, so
    // every `bun run build` cold-busted the `quality` typecheck cache and vice
    // versa. Separate files keep both caches warm independently.
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "tmp",
    // Vendored upstream subtrees (ADR-031). `include: ["src"]` already keeps
    // them out of this program, but `exclude` is REPLACED rather than merged
    // when a config extends another, so this file would otherwise be the one
    // tsconfig in the repo with no vendor exclusion of its own.
    "vendor",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "specs",
    "scripts"
  ]
}
