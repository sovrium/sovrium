{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    // MUST stay false. The generated `embedded-runtime-assets.generated.ts`
    // asset-imports ~470 pre-built `dist/island-chunks/*.js` bundles via
    // `import _r from '../../../dist/*.js' with { type: 'file' }` (opaque file
    // handles consumed by Bun's bundler, never as typed modules). With
    // `allowJs: true`, tsc resolved those bundled JS artifacts INTO the program
    // (relative imports bypass `exclude`) and tried to infer + serialize their
    // deeply-nested type graphs for the incremental `.tsbuildinfo` /
    // declaration emit — overflowing the call stack
    // (`serializeTypeForDeclaration` → RangeError) whenever `dist/` was present
    // on disk. No `.ts`/`.tsx` source depends on JS type-checking, and the only
    // plain `.js` files in src/ (presentation/scripts/client/*.js) are
    // standalone browser scripts that are never module-imported, so disabling
    // JS parsing is purely correct here. Also protects the release
    // declaration-emit build (tsconfig.build.json), which inherits this and
    // would crash identically. See the "no dist → clean / with dist → crash"
    // bisection. DO NOT flip back to true.
    "allowJs": false,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Incremental type checking — persist the dependency graph to a fixed,
    // gitignored cache so warm `typecheck`/`quality` runs only re-check changed
    // files. node_modules is already gitignored, so the cache survives cleans.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo",

    // Explicit type declarations (required in TS 6 — types defaults to [])
    "types": ["bun", "node", "react-dom", "nodemailer", "pg"],

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (enabled for code quality)
    "noUnusedLocals": true,
    "noUnusedParameters": false, // Disabled to allow incomplete test stubs in specs/
    "noPropertyAccessFromIndexSignature": false,

    // Path aliases (baseUrl deprecated in TS 7, silence for now)
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/specs/*": ["specs/*"],
      "@apps/*": ["apps/*"],
      // Resolve the `sovrium` config-types specifier to its source. Outside this
      // repo that specifier is satisfied by the `sovrium.d.ts` that `sovrium types`
      // generates; in-repo there is no generated declaration to pick up, so the
      // alias points at the same file the generator READS — `src/index.ts`, whose
      // TYPE_EXPORTS block scripts/build/build-types.ts extracts.
      //
      // Pointing it at the emitter's own input is the whole design. The alias used
      // to target a second, hand-maintained surface (packages/types/src/index.ts)
      // that exported 34 names against the 16 the binary shipped; four apps/partner
      // configs imported two of the extras and typechecked green here while failing
      // with TS2305 for every author outside this repo. One surface cannot drift
      // from itself.
      //
      // It is still WIDER than the shipped declaration in one direction: src/index.ts
      // is the internal entry point, so it also exports four runtime VALUES that a
      // declaration cannot carry. scripts/drift/check-sovrium-specifier-surface.ts is what
      // stops a config importing one — ESLint cannot, because apps/** and
      // templates/** are in the global ignores.
      //
      // Without this alias a clean checkout fails typecheck with TS2307 the moment
      // anything in the program imports it. Matches the @apps/* / @/* pattern above.
      "sovrium": ["src/index.ts"]
    }
  },
  // Bound the typecheck program to the four source roots only. Without an explicit
  // `include`, tsc defaults to "every .ts under the project root minus exclude",
  // silently pulling in stray files (templates/, and historically packages/types,
  // which carried its own tsconfig). Dependents that override `include`
  // (tsconfig.build.json → ["src"], tsconfig.eslint.json → []) are unaffected.
  "include": ["src", "specs", "scripts", "apps"],
  "exclude": ["node_modules", "dist", "tmp", "vendor", "docs"]
}
