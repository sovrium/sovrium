{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sovrium",
  "version": "../package.json",
  "identifier": "com.sovrium.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sovrium",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://sovrium.com/desktop/latest.json"],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["sovrium"],
    "publisher": "ESSENTIAL SERVICES",
    "homepage": "https://sovrium.com",
    "copyright": "Copyright (c) 2025-2026 ESSENTIAL SERVICES",
    "license": "BUSL-1.1",
    "licenseFile": "../../LICENSE.md",
    "category": "DeveloperTool",
    "shortDescription": "Run a Sovrium app on your own machine.",
    "longDescription": "Sovrium reads one configuration file and runs the application it describes. The desktop app packages that engine with a window, so a project is a folder you open rather than a server you administer.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0 | libgtk-3-0t64",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
